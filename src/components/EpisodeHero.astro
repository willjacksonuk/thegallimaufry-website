---
import type { Episode } from "../lib/episodes";
const { episode } = Astro.props as { episode: Episode };
---

<section>
  <div class="hero">
    <div class="hero-outer fade-up-text">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">
            Episode {episode.number} - {episode.readableDate}
          </p>
          <h1 class="episode-hero-title">{episode.title}</h1>
          <p class="episode-hero-time">
            Length: {episode.readableLength}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
