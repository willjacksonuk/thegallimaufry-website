---
import { Image } from "astro:assets";
import hourglassImage from "../assets/images/hourglass.svg";
import ListenOn from "./ListenOn.astro";
---

<section>
  <div class="hero">
    <div class="hero-outer fade-up-text">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">A hodgepodge history podcast - Est. 2020</p>
          <h1 class="hero-header">
            <span class="hero-the">the</span><br />
            <span class="hero-title">Gallimaufry</span>
          </h1>
          <p class="hero-description">
            Two lovers of the past pontificate on the weird, the wonderful, and
            the often overlooked. Crafted in a carpet shop basement. New
            episodes every month.
          </p>
          <ListenOn />
        </div>
        <div class="hero-image">
          <Image src={hourglassImage} alt="Hourglass image" />
        </div>
      </div>
    </div>
  </div>
</section>
