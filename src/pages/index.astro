---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import { episodeCatalogue } from "../lib/buzzsprout";
import * as show from "../lib/show";

const episodes = await episodeCatalogue.all();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: show.name,
  url: show.url,
  description: show.description,
  image: show.defaultImage,
  webFeed: show.rssFeed,
};
---

<Layout
  title="The Gallimaufry History Podcast"
  description={show.description}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <!-- Hero section -->
  <Hero />

  <!-- Episode listing -->
  <section class="container">
    <div class="episode-list">
      <div class="episode-list-header">
        <h2 class="episode-list-header-title">Episodes</h2>
        <span class="episode-list-header-count"
          >{episodes.length} total</span
        >
      </div>

      {
        episodes.map((episode) => (
          <div class="episode-row">
            <span class="episode-number">{episode.number}</span>
            <span class="episode-title">
              <h3>
                <a href={episode.path}>
                  {episode.title}
                </a>
              </h3>
            </span>
            <div class="episode-data">
              <span class="episode-date">
                {episode.readableDate}
              </span>
              <span class="episode-length">
                {episode.readableLength}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>