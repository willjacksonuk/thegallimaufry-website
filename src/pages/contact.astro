---
import Layout from "../layouts/Layout.astro";
import { TURNSTILE_SITE_KEY } from "astro:env/client";
import { HONEYPOT_FIELD } from "../lib/enquiry-fields";
---

<Layout
    title="The Gallimaufry History Podcast - Contact Us"
    description="Two enthusiasts of the past explore the weird, the overlooked, and the occasionally ridiculous. New episodes monthly, crafted in a carpet shop basement."
>
    <!-- Set up the contact form -->
    <script>
        import { actions } from "astro:actions";
        import { setUpContactForm } from "../scripts/contact-form";

        document.addEventListener("astro:page-load", () => {
            const form = document.getElementById(
                "contact-form",
            ) as HTMLFormElement | null;
            if (form) setUpContactForm(form, { send: actions.sendMail });
        });
    </script>

    <!-- Contact form -->
    <section>
        <div class="about-background">
            <div class="container">
                <div class="contact-container">
                    <div id="contact-text-container">
                        <div class="page-heading">
                            <h1>Contact us</h1>
                        </div>
                        <p>
                            Got a question, correction, curious historical
                            rabbit hole, or half-remembered tale you think we
                            should look into? Send us a message - we’d love to
                            hear from you.
                        </p>
                    </div>
                    <div id="contact-form-container">
                        <p id="success-message" style="display: none;">
                            Thanks for getting in touch. We'll get back to you
                            soon.
                        </p>
                        <p id="error-message" role="alert" style="display: none;">
                            Sorry, we couldn't send your message. Please try
                            again, or email us at{" "}
                            <a href="mailto:info@thegallimaufry.show"
                                >info@thegallimaufry.show</a
                            >.
                        </p>
                        <form
                            id="contact-form"
                            method="POST"
                            class="grid gap-4"
                        >
                            <input
                                name="name"
                                type="text"
                                placeholder="Name"
                                required
                            />
                            <div class="form-extra" aria-hidden="true">
                                <label for="website">Website</label>
                                <input
                                    id="website"
                                    type="text"
                                    name={HONEYPOT_FIELD}
                                    tabindex="-1"
                                    autocomplete="off"
                                />
                            </div>
                            <input
                                name="email"
                                type="email"
                                placeholder="Email"
                                required
                            />
                            <textarea
                                name="message"
                                placeholder="Message"
                                required></textarea>
                            <div
                                id="turnstile-widget"
                                data-sitekey={TURNSTILE_SITE_KEY}
                            >
                            </div>
                            <button type="submit"> Send </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
